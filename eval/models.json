{
  "_note": "No keys here. Each provider's key is read from the environment variable named in key_env (a GitHub secret). tpm = tokens per minute the script should stay under (conservative default). Model ids are checked against the provider's /models list at run time; missing ones are skipped with a warning.",
  "groq": {
    "base": "https://api.groq.com/openai/v1",
    "key_env": "GROQ_API_KEY",
    "tpm": 6000,
    "models": [
      "openai/gpt-oss-120b",
      "openai/gpt-oss-20b",
      "qwen/qwen3.8-27b"
    ]
  },
  "github": {
    "base": "https://models.github.ai/inference",
    "list_url": "https://models.github.ai/catalog/models",
    "key_env": "GH_MODELS_TOKEN",
    "tpm": 8000,
    "rpm": 8,
    "models": [],
    "headers": {
      "Accept": "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28"
    },
    "_note": "disabled for now: catalog and chat endpoints returned non-JSON 'OK' from Actions; to be debugged"
  },
  "nvidia": {
    "base": "https://integrate.api.nvidia.com/v1",
    "key_env": "NVIDIA_API_KEY",
    "tpm": 30000,
    "rpm": 20,
    "models": [
      "meta/llama-3.3-70b-instruct",
      "deepseek-ai/deepseek-v3.1",
      "mistralai/mistral-large-2-instruct",
      "nvidia/llama-3.3-nemotron-super-49b-v1",
      "google/gemma-3-27b-it",
      "moonshotai/kimi-k2-instruct"
    ]
  },
  "mistral": {
    "base": "https://api.mistral.ai/v1",
    "key_env": "MISTRAL_API_KEY",
    "tpm": 30000,
    "rpm": 20,
    "models": [
      "mistral-large-4",
      "mistral-medium-latest",
      "mistral-small-latest"
    ]
  },
  "openrouter": {
    "base": "https://openrouter.ai/api/v1",
    "key_env": "OPENROUTER_API_KEY",
    "tpm": 20000,
    "rpm": 10,
    "models": [
      "nvidia/nemotron-3-ultra-550b-a55b:free",
      "dots-studio/dots-3-note-preview:free"
    ],
    "list_filter": ":free"
  }
}